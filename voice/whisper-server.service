[Unit]
Description=Whisper.cpp STT server (large-v3-turbo) for opencode-voice
Documentation=https://github.com/ggml-org/whisper.cpp

[Service]
ExecStart=%h/opt/whisper.cpp/build/bin/whisper-server \
  -m %h/.local/share/whisper-cpp/ggml-large-v3-turbo.bin \
  --host 127.0.0.1 --port 8178 \
  --inference-path /audio/transcriptions \
  -l fa -t 8 \
  --vad -vm %h/.local/share/whisper-cpp/for-tests-silero-v6.2.0-ggml.bin
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
