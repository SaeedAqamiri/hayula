#!/usr/bin/env python3
import json
import os
import subprocess
import time
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SERVICE = "whisper-server"
WHISPER = "http://127.0.0.1:8178/audio/transcriptions"
PROBE = os.path.expanduser("~/.cache/voice-probe.wav")


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True)


def active():
    return systemctl("is-active", SERVICE).stdout.strip() == "active"


def ready(timeout=8):
    try:
        boundary = uuid.uuid4().hex
        with open(PROBE, "rb") as f:
            audio = f.read()
        body = (
            f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="probe.wav"\r\n'
            f"Content-Type: audio/wav\r\n\r\n"
        ).encode() + audio + (
            f'\r\n--{boundary}\r\nContent-Disposition: form-data; name="response_format"\r\n\r\njson\r\n--{boundary}--\r\n'
        ).encode()
        req = urllib.request.Request(
            WHISPER,
            data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        )
        urllib.request.urlopen(req, timeout=timeout).read()
        return True
    except Exception:
        return False


def state():
    if not active():
        return "down"
    return "up" if ready() else "loading"


def wait_up(deadline=120):
    end = time.time() + deadline
    while time.time() < end:
        if ready():
            return True
        if not active():
            return False
        time.sleep(1)
    return False


class Handler(BaseHTTPRequestHandler):
    def _cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")

    def _json(self, payload, code=200):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self._cors()
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self._cors()
        self.end_headers()

    def do_GET(self):
        if self.path == "/status":
            self._json({"state": state()})
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        if self.path == "/toggle":
            if active():
                systemctl("stop", SERVICE)
                self._json({"state": "down"})
            else:
                systemctl("start", SERVICE)
                self._json({"state": "up" if wait_up() else "failed"})
        elif self.path == "/up":
            if not active():
                systemctl("start", SERVICE)
            self._json({"state": "up" if wait_up() else "failed"})
        elif self.path == "/down":
            systemctl("stop", SERVICE)
            self._json({"state": "down"})
        else:
            self._json({"error": "not found"}, 404)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    os.makedirs(os.path.dirname(PROBE), exist_ok=True)
    if not os.path.exists(PROBE):
        subprocess.run(["sox", "-n", "-r", "16000", "-c", "1", PROBE, "trim", "0", "0.1"], capture_output=True)
    ThreadingHTTPServer(("127.0.0.1", 8179), Handler).serve_forever()
